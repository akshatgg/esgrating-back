MONGO_URL=mongodb://localhost:27017
MONGO_DB=esg_score_calculator
ESG_OPENAI_API_KEY=
ESG_OPENAI_MODEL=gpt-3.5-turbo-1106
BFSI_OPENAI_API_KEY=
BFSI_OPENAI_MODEL=gpt-4o-mini
# Required (32+ chars) -- the API refuses to start without it. Generate one with:
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
SESSION_SECRET=
SESSION_TTL_HOURS=8
UPLOAD_DIR=./uploads
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_SSL=true
MAIL_FROM=info@esgratings.co.in
TEAM_EMAIL=info@esgratings.co.in
WEB_ORIGIN=http://localhost:3000
TRUST_PROXY=false
# With TRUST_PROXY=true: number of our own proxies in front of the API; client IP = the X-Forwarded-For entry this many from the right.
TRUSTED_PROXY_HOPS=1
# With TRUST_PROXY=true: use CF-Connecting-IP instead (only safe if the origin accepts traffic from Cloudflare alone).
TRUST_CLOUDFLARE=false
